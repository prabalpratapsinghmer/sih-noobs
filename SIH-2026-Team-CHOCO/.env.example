# Project
PROJECT_NAME=SIH26184
ENVIRONMENT=development

# CUDA
CUDA_VISIBLE_DEVICES=0

# Database - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih26184_app
POSTGRES_USER=sih_admin
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32

# Database - Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
NEO4J_DATABASE=neo4j

# Database - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here

# Blockchain
BLOCKCHAIN_RPC_URL=https://rpc-mumbai.maticvigil.com
CONTRACT_ADDRESS=your_contract_address_here
PRIVATE_KEY=your_private_key_here

# JWT — Generate a 64+ character random secret. Example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Postgres Field Encryption — 64 hex chars (32 bytes). Example:
#   python -c "import secrets; print(secrets.token_hex(32))"
PG_ENCRYPTION_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Google OAuth — Create credentials at:
#   https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Web application)
# 2. Add your domain to "Authorized JavaScript origins"
# 3. Add your domain/callback to "Authorized redirect URIs"
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Frontend API URL. Leave unset when using `npm run dev` (Vite proxies /api to
# the local backend). In production, set this to the public HTTPS origin of the
# separately deployed FastAPI service (for example, https://api.gaurdian.gov.in).
VITE_API_BASE_URL=

# CORS - JSON array of allowed origins. Do NOT use ["*"] in production.
# Example: ["https://gaurdian.gov.in","https://www.gaurdian.gov.in"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Publicly reachable deployment of the ATM model service. Do not use localhost
# outside local development.
MODEL_API_URL=http://localhost:8001

# Monitoring & Observability
PROMETHEUS_PORT=9090
OTEL_SERVICE_NAME=sih26184-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cybercrime_complaints

# Supabase (Dual-Mode Cloud / Realtime / Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence

# Local / Free LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
