{
  "title": "SIH26184 Backend",
  "uid": "sih26184-backend",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(sih_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request latency p95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sih_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 all"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sih_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 all"
        }
      ]
    },
    {
      "id": 3,
      "title": "Database probes",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0.5 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sih_db_probe",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Backend process memory / CPU",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "decbytes" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "cpu_seconds" }, "properties": [{ "id": "unit", "value": "short" }] }
        ]
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"backend\"}",
          "legendFormat": "rss"
        },
        {
          "expr": "process_virtual_memory_bytes{job=\"backend\"}",
          "legendFormat": "vms"
        },
        {
          "expr": "rate(process_cpu_seconds_total{job=\"backend\"}[5m])",
          "legendFormat": "cpu_seconds"
        }
      ]
    }
  ]
}